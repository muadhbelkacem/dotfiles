# Mako configuration - Dark Colorscheme Theme

font=JetBrainsMono Nerd Font 11
width=350
height=150
margin=15
padding=15
border-size=2
border-radius=4
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0
group-by=summary,body

background-color=#101010
text-color=#e4e4ef
border-color=#ffdd33
progress-color=over #73c936

[urgency=low]
border-color=#383838
default-timeout=2000

[urgency=normal]
border-color=#ffdd33
default-timeout=5000

[urgency=high]
border-color=#f43841
default-timeout=0

[grouped]
format=(%g) <b>%s</b>\n%b
on-button-left=dismiss-group

[summary="Volume"]
background-color=#212121
text-color=#96a6c8
border-color=#96a6c8
progress-color=#101010

[summary="Brightness"]
background-color=#212121
text-color=#95a99f
border-color=#95a99f
progress-color=#101010

[summary="Battery"]
background-color=#212121
text-color=#73c936
border-color=#73c936
progress-color=#101010

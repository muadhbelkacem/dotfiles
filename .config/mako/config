# Mako configuration - Gruvbox Theme

font=JetBrainsMono Nerd Font 11
width=350
height=150
margin=15
padding=15
border-size=2
border-radius=4
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0
group-by=summary,body

background-color=#282828
text-color=#ebdbb2
border-color=#fe8019
progress-color=over #8ec07c

[urgency=low]
border-color=#3c3836
default-timeout=2000

[urgency=normal]
border-color=#fe8019
default-timeout=5000

[urgency=high]
border-color=#fb4934
default-timeout=0

[grouped]
format=(%g) <b>%s</b>\n%b
on-button-left=dismiss-group

[summary="Volume"]
background-color=#458588
text-color=#282828
border-color=#83a598
progress-color=over #83a598

[summary="Brightness"]
background-color=#d79921
text-color=#282828
border-color=#fabd2f
progress-color=over #fabd2f

[summary="Battery"]
background-color=#98971a
text-color=#282828
border-color=#b8bb26
progress-color=over #b8bb26

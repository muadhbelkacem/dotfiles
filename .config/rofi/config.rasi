configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 11";
    icon-theme:                 "Papirus";
}

@import "/dev/null"

* {
    bg0:     #292522;
    bg1:     #34302c;
    bg2:     #403a36;
    bg3:     #524942;
    bg4:     #6b5d52;
    fg:      #ece1d7;
    red:     #c4746e;
    blue:    #89b3b6;
    green:   #85b695;
    yellow:   #ebc06d;

    background-color:            transparent;
    text-color:                  @fg;
    margin:                      0;
    padding:                     0;
    spacing:                     0;
}

window {
    width:                       600px;
    enabled:                     true;
    border:                      2px solid;
    border-radius:               0px;
    border-color:                @yellow;
    background-color:            @bg0;
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     15px;
    background-color:            @bg1;
    text-color:                  @fg;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     false;
    background-color:            transparent;
    text-color:                  @green;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           @bg4;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     5px;
    margin:                      0px;
    padding:                     10px;
    border:                      0px;
    background-color:            transparent;
}

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px;
    border:                      0px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @fg;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @fg;
}

element normal.urgent {
    background-color:            @red;
    text-color:                  @bg0;
}

element normal.active {
    background-color:            @green;
    text-color:                  @bg0;
}

element selected.normal {
    background-color:            @bg2;
    text-color:                  @green;
}

element selected.urgent {
    background-color:            @red;
    text-color:                  @bg0;
}

element selected.active {
    background-color:            @bg2;
    text-color:                  @green;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @fg;
}

element alternate.urgent {
    background-color:            @red;
    text-color:                  @bg0;
}

element alternate.active {
    background-color:            @green;
    text-color:                  @bg0;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        28px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:             0.0;
}

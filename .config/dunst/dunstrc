[global]
    font = JetBrains Mono 10
    frame_width = 2
    frame_color = "#867462"
    corner_radius = 0
    transparency = 0
    padding = 10
    horizontal_padding = 10
    icon_corner_radius = 0
    progress_bar_corner_radius = 0
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corners = all
    separator_color = frame
    gap_size = 4
    alignment = left
    vertical_alignment = center
    width = (0, 400)
    height = (0, 300)
    origin = bottom-center
    offset = (20, 40)
    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "#292522"
    foreground = "#ece1d7"
    frame_color = "#403a36"
    timeout = 6

[urgency_normal]
    background = "#292522"
    foreground = "#ece1d7"
    frame_color = "#867462"
    timeout = 8

[urgency_critical]
    background = "#292522"
    foreground = "#ece1d7"
    frame_color = "#d47766"
    timeout = 0

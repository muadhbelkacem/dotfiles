[global]
    font = JetBrains Mono 10
    frame_width = 2
    frame_color = "#a7c080"
    corner_radius = 10
    transparency = 0
    padding = 10
    horizontal_padding = 10
    icon_corner_radius = 8
    progress_bar_corner_radius = 8
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corners = all
    separator_color = frame
    gap_size = 4
    alignment = left
    vertical_alignment = center
    width = (0, 400)
    height = (0, 300)
    origin = top-right
    offset = (20, 40)
    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "#272e33"
    foreground = "#d3c6aa"
    frame_color = "#475258"
    timeout = 6

[urgency_normal]
    background = "#272e33"
    foreground = "#d3c6aa"
    frame_color = "#a7c080"
    timeout = 8

[urgency_critical]
    background = "#272e33"
    foreground = "#d3c6aa"
    frame_color = "#e67e80"
    timeout = 0
